---
/**
 * What search engines and link previews read, the same on every page: the title,
 * the address that counts as the real one, the card shown when the link is shared,
 * and who this site is about (name, role, city, public profiles) in a form machines read.
 * Nothing here is visible on the page. No phone number and no email: see `onRequest` in journey.ts.
 */
import { contacts, profile } from '../data/journey.ts';
import { isTodo } from '../lib/todos.ts';

interface Props {
  title: string;
  description: string;
  /** Where the page lives inside the site: "/" or "/cv/". */
  path: string;
}

const { title, description, path } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const absolute = (to: string) => new URL(`${base}${to}`, Astro.site).href;

const home = absolute('/');
const url = absolute(path);

// public/preview.png, 1200 × 630: drawn by tools/preview-image.html.
const image = absolute('/preview.png');
const imageAlt = `${profile.name}, ${profile.role}. A seafront at dawn, with the pylon of the Strait of Messina.`;

const profiles = Object.entries(contacts as Record<string, string>)
  .filter(([key, value]) => key !== 'email' && value && !isTodo(value))
  .map(([, value]) => value);

const data = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url,
  name: title,
  inLanguage: 'en',
  mainEntity: {
    '@type': 'Person',
    '@id': `${home}#person`,
    name: profile.name,
    jobTitle: profile.role,
    description: profile.summary,
    url: home,
    address: { '@type': 'PostalAddress', addressLocality: profile.city, addressCountry: profile.country },
    sameAs: profiles,
  },
};

// "<" is escaped so that no text from journey.ts can close the script tag.
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={profile.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<script is:inline type="application/ld+json" set:html={json}></script>

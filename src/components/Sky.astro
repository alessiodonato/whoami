---
/** Layer 1: the sky. Five flat bands, the sun, the moon, the stars. Decorative. */
import { starShadows } from '../lib/scene.ts';

const stars = starShadows(1908, 90);
---

<div class="sky" id="sky" aria-hidden="true">
  <div class="sky__stars" style={`box-shadow:${stars}`}></div>
  <div class="sky__sun"></div>

  <svg class="sky__moon" viewBox="0 0 100 100" focusable="false">
    <circle class="moon__halo" cx="50" cy="50" r="50"></circle>
    <g class="moon__disc">
      <circle class="moon__face" cx="50" cy="50" r="34"></circle>
      <g class="moon__craters">
        <circle cx="38" cy="40" r="6"></circle>
        <circle cx="60" cy="58" r="8"></circle>
        <circle cx="57" cy="33" r="3.5"></circle>
        <circle cx="40" cy="64" r="3"></circle>
      </g>
    </g>
  </svg>

  <svg class="cloud cloud--a" viewBox="0 0 260 70" focusable="false">
    <rect x="0" y="38" width="260" height="32" rx="16"></rect>
    <rect x="52" y="14" width="150" height="34" rx="17"></rect>
    <rect x="96" y="0" width="70" height="30" rx="15"></rect>
  </svg>
  <svg class="cloud cloud--b" viewBox="0 0 200 52" focusable="false">
    <rect x="0" y="24" width="200" height="28" rx="14"></rect>
    <rect x="40" y="0" width="104" height="32" rx="16"></rect>
  </svg>
  <svg class="cloud cloud--c" viewBox="0 0 320 60" focusable="false">
    <rect x="0" y="30" width="320" height="30" rx="15"></rect>
    <rect x="70" y="8" width="170" height="32" rx="16"></rect>
    <rect x="190" y="0" width="80" height="26" rx="13"></rect>
  </svg>
</div>
